{
  "expo": {
    "name": "NATIONAL ENTERPRISES",
    "slug": "national-enterprises",
    "version": "1.1.0",
    "runtimeVersion": { "policy": "appVersion" },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "com.nationalenterprises.app",
      "versionCode": 2,
      "permissions": [
        "INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.nationalenterprises.app",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
